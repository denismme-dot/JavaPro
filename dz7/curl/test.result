    "id": 1,
    "accountNumber": "ACC-TANYA-1",
    "balance": 1450.00,
    "productType": "ACCOUNT",
    "userId": 1
  }
]

--- successful payment ---

>>> curl -s -X POST http://localhost:8082/api/v1/payments/execute -H 'Content-Type: application/json' -d '{"productId":1,"amount":100.00}'
{
  "productId": 1,
  "accountNumber": "ACC-TANYA-1",
  "amount": 100.00,
  "balanceAfter": 1350.00,
  "status": "SUCCESS"
}

--- payment: insufficient funds ---

>>> curl -s -X POST http://localhost:8082/api/v1/payments/execute -H 'Content-Type: application/json' -d '{"productId":1,"amount":999999.00}'
